{
  "name": "mydaily-quiz",
  "main": "src/index.tsx",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "mydaily.irish", "custom_domain": true },
    { "pattern": "www.mydaily.irish", "custom_domain": true }
  ],
  "vars": {
    "EMAIL_FROM": "Daily Quiz <quiz@mydaily.irish>"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mydaily-quiz-subscribers",
      "database_id": "74a12d87-7918-44fe-8918-d6ac0b632bdf",
      "migrations_dir": "migrations"
    }
  ]
}
